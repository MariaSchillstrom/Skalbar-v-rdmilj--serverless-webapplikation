        <mxCell id="xX48_kaocdxkzJORoY4O-36" value="&lt;ol data-start=&quot;143&quot; data-end=&quot;592&quot;&gt;&lt;li data-start=&quot;143&quot; data-end=&quot;217&quot;&gt;&lt;p data-start=&quot;146&quot; data-end=&quot;217&quot;&gt;&lt;strong data-start=&quot;146&quot; data-end=&quot;168&quot;&gt;Browser (Frontend)&lt;/strong&gt; laddar statisk webbplats från &lt;strong data-start=&quot;199&quot; data-end=&quot;205&quot;&gt;S3&lt;/strong&gt; via HTTP.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;218&quot; data-end=&quot;303&quot;&gt;&lt;p data-start=&quot;221&quot; data-end=&quot;303&quot;&gt;&lt;strong data-start=&quot;221&quot; data-end=&quot;229&quot;&gt;AJAX&lt;/strong&gt; i webbläsaren skickar &lt;strong data-start=&quot;252&quot; data-end=&quot;273&quot;&gt;HTTPS (JSON/REST)&lt;/strong&gt;-anrop till &lt;strong data-start=&quot;285&quot; data-end=&quot;300&quot;&gt;API Gateway&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;304&quot; data-end=&quot;389&quot;&gt;&lt;p data-start=&quot;307&quot; data-end=&quot;389&quot;&gt;&lt;strong data-start=&quot;307&quot; data-end=&quot;322&quot;&gt;API Gateway&lt;/strong&gt; &lt;strong data-start=&quot;323&quot; data-end=&quot;336&quot;&gt;invokerar&lt;/strong&gt; (anropar) &lt;strong data-start=&quot;347&quot; data-end=&quot;361&quot;&gt;AWS Lambda&lt;/strong&gt;, som kör backend-logiken.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;390&quot; data-end=&quot;492&quot;&gt;&lt;p data-start=&quot;393&quot; data-end=&quot;492&quot;&gt;&lt;strong data-start=&quot;393&quot; data-end=&quot;403&quot;&gt;Lambda&lt;/strong&gt; har en &lt;strong data-start=&quot;411&quot; data-end=&quot;423&quot;&gt;IAM Role&lt;/strong&gt; som ger åtkomst till &lt;strong data-start=&quot;445&quot; data-end=&quot;489&quot;&gt;DynamoDB (Table: Svampar, PK: svampnamn)&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;493&quot; data-end=&quot;592&quot;&gt;&lt;p data-start=&quot;496&quot; data-end=&quot;592&quot;&gt;&lt;strong data-start=&quot;496&quot; data-end=&quot;506&quot;&gt;Lambda&lt;/strong&gt; returnerar data till &lt;strong data-start=&quot;528&quot; data-end=&quot;543&quot;&gt;API Gateway&lt;/strong&gt;, som skickar svaret tillbaka till webbläsaren.&lt;/p&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ol&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
